# Chỉ đặt ở máy chủ. TUYỆT ĐỐI không bỏ API key vào app.js hay HTML.
OPENAI_API_KEY=sk-your-server-key
TEXT_MODEL=gpt-4.1-mini
VISION_MODEL=gpt-4.1-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Mã truy cập dùng cá nhân; khi chia sẻ rộng, triển khai đăng nhập & giới hạn yêu cầu.
APP_ACCESS_CODE=
# Khi deploy, trỏ đến ổ đĩa lưu trữ bền vững:
DB_PATH=./studio.sqlite3
